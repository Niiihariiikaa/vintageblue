# Copy this file to `.env` in the same folder and fill in real values.
# Never commit the real .env file — it's already in .gitignore.

# Your store's *.myshopify.com domain (not a custom domain), e.g.:
# SHOPIFY_STORE_DOMAIN=vintage-blue-demo.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API access token — NOT the Admin API token.
# Get it from: Shopify Admin -> Settings -> Apps and sales channels ->
# Develop apps -> Create an app -> Configure Storefront API scopes ->
# Install app -> API credentials tab -> "Storefront API access token".
SHOPIFY_STOREFRONT_TOKEN=
